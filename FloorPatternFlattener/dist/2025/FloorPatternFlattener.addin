<?xml version="1.0" encoding="utf-8"?>
<!--
  Revit 2025 install pair. Copy this .addin and FloorPatternFlattener.dll into:
    %AppData%\Autodesk\Revit\Addins\2025\
  Assembly is the DLL file name, so both files must stay in that folder.
  Restart Revit 2025.

  VendorId "TWISTOFFATE" is also the vendor id of the add-in's extensible storage schemas
  and of its (optional) Dynamic Model Update updater. Revit requires 4+ characters for schema
  vendor ids. Do not change it once models contain flattened floors.
-->
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Floor Pattern Flattener</Name>
    <Assembly>FloorPatternFlattener.dll</Assembly>
    <FullClassName>FloorPatternFlattener.App</FullClassName>
    <ClientId>B2E8D401-9C5A-4F17-8E3D-6A1B0C9F4E72</ClientId>
    <VendorId>TWISTOFFATE</VendorId>
    <VendorDescription>Floor Pattern Flattener contributors</VendorDescription>
  </AddIn>
</RevitAddIns>
