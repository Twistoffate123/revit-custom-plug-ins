<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>FloorPatternFlattener</AssemblyName>
    <RootNamespace>FloorPatternFlattener</RootNamespace>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);REVIT_2025</DefineConstants>
    <RevitVersion>2025</RevitVersion>
    <UseWPF>true</UseWPF>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(Revit2025Path)\RevitAPI.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(Revit2025Path)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

    <ItemGroup>
      <Compile Include="..\FloorPatternFlattener.Core\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  <!-- Year-specific files in this folder (optional) -->
  <ItemGroup>
    <Compile Include="RevitYearInfo.cs" />
  </ItemGroup>

  <Target Name="CopyDist2025" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_DistDir>$(MSBuildThisFileDirectory)..\..\dist\2025</_DistDir>
    </PropertyGroup>
    <MakeDir Directories="$(_DistDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\addin\FloorPatternFlattener.addin" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\addin\FpfSharedParameters.txt" DestinationFolder="$(_DistDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
