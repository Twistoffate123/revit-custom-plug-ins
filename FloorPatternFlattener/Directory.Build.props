<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Override these paths in a sibling Directory.Build.props.user (gitignored)
    or pass /p:Revit2024Path="C:\Program Files\Autodesk\Revit 2024" on the command line.
    Defaults match a standard Autodesk Windows install.
  -->
  <PropertyGroup>
    <Revit2023Path Condition="'$(Revit2023Path)' == ''">C:\Program Files\Autodesk\Revit 2023</Revit2023Path>
    <Revit2024Path Condition="'$(Revit2024Path)' == ''">C:\Program Files\Autodesk\Revit 2024</Revit2024Path>
    <Revit2025Path Condition="'$(Revit2025Path)' == ''">C:\Program Files\Autodesk\Revit 2025</Revit2025Path>
    <Revit2026Path Condition="'$(Revit2026Path)' == ''">C:\Program Files\Autodesk\Revit 2026</Revit2026Path>
    <Revit2027Path Condition="'$(Revit2027Path)' == ''">C:\Program Files\Autodesk\Revit 2027</Revit2027Path>

    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
